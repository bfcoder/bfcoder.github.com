---
import Layout from '@layouts/Layout.astro';
import Icon from '@components/Icon.astro';
---

<Layout title='Page Not Found'>
  <section class="mx-auto flex max-w-xl flex-col items-center px-4 py-32 text-center">
    <p class="font-mono text-sm font-semibold text-brand-600 dark:text-brand-400">404</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-zinc-900 sm:text-5xl dark:text-white">Oops! Page not found</h1>
    <p class="mt-4 text-lg text-zinc-600 dark:text-zinc-400">The page you're looking for doesn't exist or has been moved.</p>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href="/" class="inline-flex items-center gap-2 rounded-full bg-zinc-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-brand-300">Go Home</a>
      <a href="/projects" class="inline-flex items-center gap-2 rounded-full border border-zinc-300 px-5 py-3 text-sm font-semibold text-zinc-900 transition hover:border-zinc-400 dark:border-zinc-700 dark:text-white">Browse projects <Icon name="arrow" size={16} /></a>
    </div>
  </section>
</Layout>
