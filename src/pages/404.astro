---
import Layout from '@layouts/Layout.astro';
import TerminalWindow from '@components/TerminalWindow.astro';
---

<Layout title='Page Not Found'>
  <section class="mx-auto max-w-2xl px-4 py-24 sm:px-6">
    <TerminalWindow title="bash — 404">
      <p class="prompt text-term-text" aria-hidden="true">cd <span data-path>/missing-page</span></p>
      <p class="text-term-red" aria-hidden="true">bash: cd: <span data-path>/missing-page</span>: No such file or directory</p>
      <h1 class="mt-6 text-3xl font-extrabold text-term-green text-glow">404: Oops! Page not found</h1>
      <p class="mt-3 text-term-text">The page you're looking for doesn't exist or has been moved.</p>
      <p class="prompt mt-6 flex flex-wrap items-center gap-3">
        <a href="/" class="border border-term-green bg-term-green px-3 py-1.5 font-bold text-term-bg hover:bg-transparent hover:text-term-green">cd ~</a>
        <a href="/projects" class="border border-term-line px-3 py-1.5 text-term-text hover:border-term-green hover:text-term-green">cd ~/projects</a>
        <span class="cursor text-term-green" aria-hidden="true"></span>
      </p>
    </TerminalWindow>
  </section>
</Layout>

<script>
  // Echo the path the visitor actually asked for.
  const path = decodeURIComponent(location.pathname);
  document.querySelectorAll('[data-path]').forEach((el) => { el.textContent = path; });
</script>
