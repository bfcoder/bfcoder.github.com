---
import Layout from '@layouts/Layout.astro';
import ProjectCard from '@components/ProjectCard.astro';
import { allTech, categories, projects } from '@data/site';

const filterTech = allTech.slice(0, 10);
const tab = 'shrink-0 whitespace-nowrap rounded-full px-3 sm:px-4 py-2 text-sm font-medium text-zinc-600 transition hover:text-zinc-900 aria-pressed:bg-zinc-900 aria-pressed:text-white dark:text-zinc-400 dark:hover:text-white dark:aria-pressed:bg-white dark:aria-pressed:text-zinc-900';
const chip = 'rounded-md border border-zinc-200 px-2.5 py-1 font-mono text-xs text-zinc-600 transition hover:border-zinc-400 aria-pressed:border-brand-600 aria-pressed:bg-brand-50 aria-pressed:text-brand-700 dark:border-zinc-800 dark:text-zinc-400 dark:hover:border-zinc-600 dark:aria-pressed:border-brand-400 dark:aria-pressed:bg-brand-700/20 dark:aria-pressed:text-brand-300';
---

<Layout title='The bfcoder: Projects'>
  <section class="border-b border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900/50">
    <div class="mx-auto max-w-6xl px-4 pt-16 pb-10 sm:px-6">
      <h1 class="text-4xl font-extrabold tracking-tight text-zinc-900 sm:text-5xl dark:text-white">My Projects</h1>
      <p class="mt-4 max-w-2xl text-lg text-zinc-600 dark:text-zinc-400">
        Here are the projects I have been involved with: {projects.length} in all, from Rails apps and Canvas LTI tools to HTML5 math modules.
      </p>

      <div class="mt-10 flex flex-col gap-4">
        <div class="flex max-w-full gap-1 self-start overflow-x-auto rounded-full border border-zinc-200 bg-white p-1 dark:border-zinc-800 dark:bg-zinc-900" role="group" aria-label="Filter by category">
          <button type="button" class={tab} data-category="all" aria-pressed="true">All <span class="opacity-60">{projects.length}</span></button>
          {categories.map((c) => (
            <button type="button" class={tab} data-category={c.id} aria-pressed="false">
              {c.label} <span class="opacity-60">{projects.filter((p) => p.category === c.id).length}</span>
            </button>
          ))}
        </div>
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by technology">
          <span class="mr-1 text-sm text-zinc-500">Tech:</span>
          {filterTech.map((t) => (
            <button type="button" class={chip} data-tech={t} aria-pressed="false">{t}</button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <p id="result-count" class="mb-6 text-sm text-zinc-500" aria-live="polite">Showing all {projects.length} projects</p>
    <div id="project-grid" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
    <div id="empty" class="hidden rounded-2xl border border-dashed border-zinc-300 p-12 text-center dark:border-zinc-700">
      <p class="font-semibold text-zinc-900 dark:text-white">No projects match those filters.</p>
      <button type="button" id="reset" class="mt-3 text-sm font-medium text-brand-700 hover:underline dark:text-brand-400">Clear filters</button>
    </div>
  </section>
</Layout>

<script>
  let category = 'all';
  const tech = new Set<string>();

  const categoryButtons = document.querySelectorAll<HTMLButtonElement>('button[data-category]');
  const techButtons = document.querySelectorAll<HTMLButtonElement>('button[data-tech]');
  const cards = document.querySelectorAll<HTMLElement>('#project-grid .project-card');
  const count = document.getElementById('result-count');
  const empty = document.getElementById('empty');

  function render() {
    let shown = 0;
    cards.forEach((card) => {
      const cardTech = (card.dataset.tech ?? '').split('|');
      const visible =
        (category === 'all' || card.dataset.category === category) &&
        [...tech].every((t) => cardTech.includes(t));
      card.hidden = !visible;
      if (visible) shown++;
    });
    categoryButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.category === category)));
    techButtons.forEach((b) => b.setAttribute('aria-pressed', String(tech.has(b.dataset.tech ?? ''))));
    if (count) count.textContent = shown === cards.length ? `Showing all ${shown} projects` : `Showing ${shown} of ${cards.length} projects`;
    empty?.classList.toggle('hidden', shown > 0);
  }

  categoryButtons.forEach((b) => b.addEventListener('click', () => {
    category = b.dataset.category ?? 'all';
    render();
  }));

  techButtons.forEach((b) => b.addEventListener('click', () => {
    const t = b.dataset.tech ?? '';
    if (tech.has(t)) tech.delete(t); else tech.add(t);
    render();
  }));

  document.getElementById('reset')?.addEventListener('click', () => {
    category = 'all';
    tech.clear();
    render();
  });
</script>
