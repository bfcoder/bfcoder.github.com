---
import Layout from '@layouts/Layout.astro';
import ProjectCard from '@components/ProjectCard.astro';
import { allTech, categories, projects } from '@data/site';

const filterTech = allTech.slice(0, 10);
const flag = 'border border-term-line px-2.5 py-1 text-xs text-term-text transition hover:border-term-green hover:text-term-green aria-pressed:border-term-green aria-pressed:bg-term-green aria-pressed:text-term-bg';
---

<Layout title='The bfcoder: Projects'>
  <section class="border-b border-term-line">
    <div class="mx-auto max-w-6xl px-4 pt-14 pb-10 sm:px-6">
      <p class="prompt text-sm text-term-dim" aria-hidden="true">ls ~/projects</p>
      <h1 class="cursor mt-3 text-3xl font-extrabold text-term-green text-glow sm:text-4xl">My Projects</h1>
      <p class="mt-4 max-w-2xl text-term-text before:text-term-dim before:content-['#_']">
        Here are the projects I have been involved with: {projects.length} in all, from Rails apps and Canvas LTI tools to HTML5 math modules.
      </p>

      <div class="mt-10 space-y-3 border border-term-line bg-term-panel p-4 text-sm">
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by category">
          <span class="w-24 shrink-0 text-term-cyan">--category</span>
          <button type="button" class={flag} data-category="all" aria-pressed="true">all <span class="opacity-60">{projects.length}</span></button>
          {categories.map((c) => (
            <button type="button" class={flag} data-category={c.id} aria-pressed="false">
              {c.label.toLowerCase()} <span class="opacity-60">{projects.filter((p) => p.category === c.id).length}</span>
            </button>
          ))}
        </div>
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by technology">
          <span class="w-24 shrink-0 text-term-cyan">--stack</span>
          {filterTech.map((t) => (
            <button type="button" class={flag} data-tech={t} aria-pressed="false">{t}</button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <p id="result-count" class="mb-6 text-sm text-term-dim" aria-live="polite"># showing all {projects.length} projects</p>
    <div id="project-grid" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
    <div id="empty" class="hidden border border-dashed border-term-line p-12 text-center text-sm">
      <p class="text-term-red">ls: no projects match those flags</p>
      <button type="button" id="reset" class="mt-3 text-term-amber hover:text-term-green">[ reset filters ]</button>
    </div>
  </section>
</Layout>

<script>
  let category = 'all';
  const tech = new Set<string>();

  const categoryButtons = document.querySelectorAll<HTMLButtonElement>('button[data-category]');
  const techButtons = document.querySelectorAll<HTMLButtonElement>('button[data-tech]');
  const cards = document.querySelectorAll<HTMLElement>('#project-grid .project-card');
  const count = document.getElementById('result-count');
  const empty = document.getElementById('empty');

  function render() {
    let shown = 0;
    cards.forEach((card) => {
      const cardTech = (card.dataset.tech ?? '').split('|');
      const visible =
        (category === 'all' || card.dataset.category === category) &&
        [...tech].every((t) => cardTech.includes(t));
      card.hidden = !visible;
      if (visible) shown++;
    });
    categoryButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.category === category)));
    techButtons.forEach((b) => b.setAttribute('aria-pressed', String(tech.has(b.dataset.tech ?? ''))));
    if (count) count.textContent = shown === cards.length ? `# showing all ${shown} projects` : `# showing ${shown} of ${cards.length} projects`;
    empty?.classList.toggle('hidden', shown > 0);
  }

  categoryButtons.forEach((b) => b.addEventListener('click', () => {
    category = b.dataset.category ?? 'all';
    render();
  }));

  techButtons.forEach((b) => b.addEventListener('click', () => {
    const t = b.dataset.tech ?? '';
    if (tech.has(t)) tech.delete(t); else tech.add(t);
    render();
  }));

  document.getElementById('reset')?.addEventListener('click', () => {
    category = 'all';
    tech.clear();
    render();
  });
</script>
