---
import Layout from '@layouts/Layout.astro';
import Icon from '@components/Icon.astro';
import ProjectCard from '@components/ProjectCard.astro';
import TerminalWindow from '@components/TerminalWindow.astro';
import { educationHtml, person, professionHtml, projects, skills, social, timeline } from '@data/site';

const featured = projects.filter((p) => p.category === 'work' && p.links.length > 0).slice(0, 3);
const yearsAtEmployer = new Date().getFullYear() - 2014;
const techCount = new Set(projects.flatMap((p) => p.tech)).size;

// neofetch-style system info, all taken from the site's own content.
const info = [
  ['Name', person.name],
  ['Role', person.role],
  ['Company', person.employer.label],
  ['Since', 'Nov 2014'],
  ['Education', 'BS Computer Science, USU'],
  ['Stack', 'Rails, React, Ember, Phoenix'],
  ['Projects', String(projects.length)],
];
const logo = String.raw` _      __
| |__  / _|
| '_ \| |_
| |_) |  _|
|_.__/|_|`;

const stats = [
  { value: `${yearsAtEmployer}+`, label: `years @ ${person.employer.label.toLowerCase()}` },
  { value: String(projects.length), label: 'projects' },
  { value: String(techCount), label: 'technologies' },
];

// Decorative short "commit hashes" for the git-log timeline.
const hash = (s: string) => {
  let h = 2166136261;
  for (const c of s) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
  return (h >>> 0).toString(16).padStart(8, '0').slice(0, 7);
};

// GNU ls quotes names containing spaces.
const lsName = (name: string) => (name.includes(' ') ? `'${name}'` : name);
---

<Layout title='The bfcoder'>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-term-line">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_60%_at_75%_10%,rgb(57_255_122/0.10),transparent)]"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 pt-14 pb-16 sm:px-6 md:pt-20 lg:grid-cols-[1.15fr_1fr]">
      <div>
        <p class="text-sm text-term-dim">// {person.role.toLowerCase()} @ {person.employer.label.toLowerCase()}</p>
        <p class="prompt mt-6 text-sm text-term-text" aria-hidden="true">whoami</p>
        <h1 class="cursor mt-2 text-3xl leading-tight font-extrabold text-term-green text-glow sm:text-4xl lg:text-5xl">
          I am {person.handle},<br />aka {person.name}.
        </h1>
        <p class="mt-6 max-w-xl text-term-text before:text-term-dim before:content-['>_']">{person.tagline}</p>
        <div class="mt-8 flex flex-wrap gap-3 text-sm">
          <a href="/projects" class="inline-flex items-center gap-2 border border-term-green bg-term-green px-4 py-2.5 font-bold text-term-bg transition hover:bg-transparent hover:text-term-green">
            [ cd ~/projects <Icon name="arrow" size={14} /> ]
          </a>
          <a href={social.github.href} target="_blank" rel="noopener" class="inline-flex items-center gap-2 border border-term-line px-4 py-2.5 text-term-text transition hover:border-term-green hover:text-term-green">
            [ <Icon name="github" size={14} /> github ]
          </a>
        </div>
      </div>

      <TerminalWindow title={`${person.handle}@web: ~ — neofetch`}>
        <p class="prompt text-term-text" aria-hidden="true">neofetch</p>
        <div class="mt-3 flex flex-col gap-5 sm:flex-row">
          <pre aria-hidden="true" class="shrink-0 font-bold leading-5 text-term-green text-glow">{logo}</pre>
          <div class="min-w-0 text-[13px] leading-6">
            <p class="font-bold"><span class="text-term-green">{person.handle}</span><span class="text-term-dim">@</span><span class="text-term-green">web</span></p>
            <p aria-hidden="true" class="text-term-dim">{'-'.repeat(person.handle.length + 4)}</p>
            <dl>
            {info.map(([k, v]) => (
              <div class="flex gap-2">
                <dt class="shrink-0 font-bold text-term-amber">{k}:</dt>
                <dd class="truncate">{v}</dd>
              </div>
            ))}
            </dl>
            <div aria-hidden="true" class="mt-3 flex">
              {['bg-term-bg', 'bg-term-red', 'bg-term-green', 'bg-term-amber', 'bg-term-cyan', 'bg-term-magenta', 'bg-term-text'].map((c) => <span class:list={['h-4 w-6', c]}></span>)}
            </div>
          </div>
        </div>
      </TerminalWindow>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-b border-term-line bg-term-panel">
    <dl class="mx-auto grid max-w-6xl grid-cols-1 divide-y divide-term-line px-4 sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:px-6">
      {stats.map((s) => (
        <div class="flex flex-col items-center gap-1 py-7">
          <dt class="order-2 text-xs text-term-dim"># {s.label}</dt>
          <dd class="order-1 text-3xl font-extrabold text-term-green text-glow">{s.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- About + git log -->
  <section id="about" class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-2">
    <div>
      <p class="prompt text-sm text-term-dim" aria-hidden="true">cat about.md</p>
      <h2 class="mt-4 text-2xl font-bold text-term-green text-glow before:text-term-dim before:content-['#_']">Profession</h2>
      <p class="prose-links mt-4 leading-7" set:html={professionHtml} />
      <h2 class="mt-10 text-2xl font-bold text-term-green text-glow before:text-term-dim before:content-['#_']">Education</h2>
      <p class="prose-links mt-4 leading-7" set:html={educationHtml} />
    </div>

    <TerminalWindow title="~/career — git log">
      <p class="prompt text-term-text" aria-hidden="true">git log</p>
      <h2 class="sr-only">Timeline</h2>
      <ol class="mt-4 space-y-6">
        {timeline.map((t, i) => (
          <li>
            <p>
              <span class="text-term-amber">commit {hash(t.org + t.when)}</span>
              {i === 0 && <span class="text-term-amber"> (<span class="font-bold text-term-cyan">HEAD -&gt; </span><span class="font-bold text-term-green">career</span>)</span>}
            </p>
            <p class="text-term-dim">Date:&nbsp;&nbsp;&nbsp;{t.when}</p>
            <p class="mt-2 pl-4 font-bold text-term-text">{t.title} @ {t.org}</p>
            <p class="pl-4 text-term-dim">{t.detail}</p>
          </li>
        ))}
      </ol>
    </TerminalWindow>
  </section>

  <!-- Skills as ls output -->
  <section id="experience" class="border-y border-term-line bg-term-panel">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <p class="prompt text-sm text-term-dim" aria-hidden="true">ls -F ~/skills</p>
      <h2 class="mt-4 text-2xl font-bold text-term-green text-glow before:text-term-dim before:content-['#_']">Tools I have worked with</h2>
      <ul class="mt-8 grid grid-cols-2 gap-x-6 gap-y-3 sm:grid-cols-3 lg:grid-cols-4">
        {skills.map((s) => {
          const name = s.includes ? `${s.name.toLowerCase()}/` : lsName(s.name);
          const color = s.includes ? 'text-term-cyan font-bold' : s.href ? 'text-term-green' : 'text-term-text';
          return (
            <li>
              {s.href
                ? <a href={s.href} target="_blank" rel="noopener" class:list={[color, 'underline decoration-dotted underline-offset-4 hover:text-term-amber']}>{name}</a>
                : <span class={color}>{name}</span>}
            </li>
          );
        })}
      </ul>
      {skills.filter((s) => s.includes).map((s) => (
        <div class="mt-10">
          <p class="prompt text-sm text-term-dim" aria-hidden="true">ls ~/skills/{s.name.toLowerCase()}/</p>
          <p class="sr-only">{s.name}, including:</p>
          <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
            {s.includes!.map((x) => (
              <li><a href={x.href} target="_blank" rel="noopener" class="text-term-green underline decoration-dotted underline-offset-4 hover:text-term-amber">{x.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured projects -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="prompt text-sm text-term-dim" aria-hidden="true">ls -t ~/projects | head -3</p>
        <h2 class="mt-4 text-2xl font-bold text-term-green text-glow before:text-term-dim before:content-['#_']">Featured projects</h2>
      </div>
      <a href="/projects" class="inline-flex items-center gap-1.5 text-sm text-term-amber hover:text-term-green">cd ~/projects <span class="text-term-dim"># all {projects.length}</span> <Icon name="arrow" size={14} /></a>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</Layout>
