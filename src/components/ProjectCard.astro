---
import type { Project } from '@data/site';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const long = project.html.join(' ').length > 260;
const categoryColor = {
  work: 'text-term-green',
  school: 'text-term-cyan',
  volunteer: 'text-term-magenta',
}[project.category];
---

<article
  class="project-card group flex flex-col border border-term-line bg-term-panel transition hover:border-term-green hover:shadow-[0_0_24px_-8px_rgb(57_255_122/0.45)]"
  data-category={project.category}
  data-tech={project.tech.join('|')}
>
  <header class="flex items-start justify-between gap-3 border-b border-dashed border-term-line px-5 py-3">
    <h3 class="font-bold text-term-green text-glow before:text-term-amber before:content-['>_']">{project.title}</h3>
    <span class:list={['shrink-0 text-xs', categoryColor]}>[{project.category}]</span>
  </header>

  <div class="flex flex-1 flex-col px-5 py-4">
    <div class:list={['prose-links space-y-3 text-sm leading-6 text-term-text', long && 'line-clamp-5 data-[expanded]:line-clamp-none']} data-body>
      {project.html.map((p) => <p set:html={p} />)}
    </div>
    {long && (
      <button type="button" class="mt-2 self-start text-xs text-term-amber hover:text-term-green" data-toggle aria-expanded="false">[+] more</button>
    )}

    <p class="mt-4 text-xs text-term-dim">
      <span class="text-term-cyan">--stack</span>{" "}
      {project.tech.map((t, i) => <><span class="text-term-text">{t}</span>{i < project.tech.length - 1 && <span>, </span>}</>)}
    </p>

    {project.links.length > 0 && (
      <div class="mt-auto pt-4">
        <div class="flex flex-wrap gap-x-4 gap-y-2 border-t border-dashed border-term-line pt-3 text-sm">
          {project.links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener" class="text-term-amber lowercase hover:text-term-green">[{l.label} ↗]</a>
          ))}
        </div>
      </div>
    )}
  </div>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('.project-card [data-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const body = button.parentElement?.querySelector<HTMLElement>('[data-body]');
      const expanded = body?.toggleAttribute('data-expanded') ?? false;
      button.textContent = expanded ? '[-] less' : '[+] more';
      button.setAttribute('aria-expanded', String(expanded));
    });
  });
</script>
