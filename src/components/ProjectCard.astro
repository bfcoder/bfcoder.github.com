---
import Icon from '@components/Icon.astro';
import type { Project } from '@data/site';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const long = project.html.join(' ').length > 260;
const categoryStyle = {
  work: 'bg-brand-50 text-brand-700 ring-brand-600/20 dark:bg-brand-700/20 dark:text-brand-300 dark:ring-brand-400/20',
  school: 'bg-sky-50 text-sky-700 ring-sky-600/20 dark:bg-sky-500/10 dark:text-sky-300 dark:ring-sky-400/20',
  volunteer: 'bg-amber-50 text-amber-700 ring-amber-600/20 dark:bg-amber-500/10 dark:text-amber-300 dark:ring-amber-400/20',
}[project.category];
---

<article
  class="project-card group flex flex-col rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-zinc-300 hover:shadow-md dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-700"
  data-category={project.category}
  data-tech={project.tech.join('|')}
>
  <div class="flex items-start justify-between gap-4">
    <h3 class="text-lg font-semibold text-zinc-900 dark:text-white">{project.title}</h3>
    <span class:list={['shrink-0 rounded-full px-2.5 py-0.5 text-xs font-medium capitalize ring-1 ring-inset', categoryStyle]}>{project.category}</span>
  </div>

  <div class:list={['prose-links mt-3 space-y-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400', long && 'line-clamp-5 data-[expanded]:line-clamp-none']} data-body>
    {project.html.map((p) => <p set:html={p} />)}
  </div>
  {long && (
    <button type="button" class="mt-2 self-start text-sm font-medium text-brand-700 hover:underline dark:text-brand-400" data-toggle aria-expanded="false">Read more</button>
  )}

  <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Technologies">
    {project.tech.map((t) => (
      <li class="rounded-md bg-zinc-100 px-2 py-0.5 font-mono text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">{t}</li>
    ))}
  </ul>

  {project.links.length > 0 && (
    <div class="mt-auto pt-5">
      <div class="flex flex-wrap gap-x-5 gap-y-2 border-t border-zinc-100 pt-4 dark:border-zinc-800">
        {project.links.map((l) => (
          <a href={l.href} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-sm font-semibold text-zinc-900 hover:text-brand-700 dark:text-white dark:hover:text-brand-400">
            {l.label}<Icon name="external" size={14} />
          </a>
        ))}
      </div>
    </div>
  )}
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('.project-card [data-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const body = button.parentElement?.querySelector<HTMLElement>('[data-body]');
      const expanded = body?.toggleAttribute('data-expanded') ?? false;
      button.textContent = expanded ? 'Show less' : 'Read more';
      button.setAttribute('aria-expanded', String(expanded));
    });
  });
</script>
