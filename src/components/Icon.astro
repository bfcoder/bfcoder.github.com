  external: { fill: false, d: ['M7 17 17 7', 'M7 7h10v10'] },
  arrow: { fill: false, d: ['M5 12h14', 'm12 5 7 7-7 7'] },
  menu: { fill: false, d: ['M4 6h16', 'M4 12h16', 'M4 18h16'] },
  close: { fill: false, d: ['M18 6 6 18', 'm6 6 12 12'] },
  sun: { fill: false, d: ['M12 3v1', 'M12 20v1', 'M3 12h1', 'M20 12h1', 'm5.6 5.6.7.7', 'm17.7 17.7.7.7', 'm5.6 18.4.7-.7', 'm17.7 6.3.7-.7', 'M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z'] },
  moon: { fill: false, d: ['M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z'] },
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  label?: string;
}

const { name, size = 18, class: className, label } = Astro.props;
const icon = icons[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={className}
  fill={icon.fill ? 'currentColor' : 'none'}
  stroke={icon.fill ? undefined : 'currentColor'}
  stroke-width={icon.fill ? undefined : 2}
  stroke-linecap={icon.fill ? undefined : 'round'}
  stroke-linejoin={icon.fill ? undefined : 'round'}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {icon.d.map((d) => <path d={d} />)}
</svg>
