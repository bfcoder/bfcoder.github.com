---
import '../styles/global.css';
import Icon from '@components/Icon.astro';
import { currentPath, nav, person, social } from '@data/site';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = `${person.name} (${person.handle}): ${person.tagline}`,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, import.meta.env.SITE).href;
const here = currentPath(Astro.url.pathname);
const footerLinks = [
  { ...social.github, icon: 'github' },
  { ...social.stackoverflow, icon: 'stackoverflow' },
  { ...social.twitter, icon: 'twitter' },
  { ...social.blog, icon: 'blog' },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" />
    <title>{title}</title>

    <link rel="canonical" href={canonicalUrl}/>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-brand-600 focus:px-3 focus:py-2 focus:text-white">Skip to content</a>

    <header class="sticky top-0 z-40 border-b border-zinc-200/80 bg-white/80 backdrop-blur-lg dark:border-zinc-800/80 dark:bg-zinc-950/80">
      <nav class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-4 sm:px-6" aria-label="Main">
        <a href="/" class="group flex items-center gap-2.5 font-semibold text-zinc-900 dark:text-white">
          <span class="grid size-8 place-items-center rounded-lg bg-zinc-900 font-mono text-sm text-brand-400 transition group-hover:bg-brand-600 group-hover:text-white dark:bg-white dark:text-brand-700">bf</span>
          <span>{person.handle}</span>
        </a>

        <ul class="ml-auto hidden items-center gap-1 md:flex">
          {nav.internal.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={here === item.href ? 'page' : undefined}
                class="rounded-full px-4 py-2 text-sm font-medium text-zinc-600 transition hover:text-zinc-900 aria-[current=page]:bg-zinc-100 aria-[current=page]:text-zinc-900 dark:text-zinc-400 dark:hover:text-white dark:aria-[current=page]:bg-zinc-800 dark:aria-[current=page]:text-white"
              >{item.label}</a>
            </li>
          ))}
          <li aria-hidden="true" class="mx-2 h-5 w-px bg-zinc-200 dark:bg-zinc-800"></li>
          {nav.external.map((item) => (
            <li>
              <a
                href={item.href}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-1 rounded-full px-3 py-2 text-sm font-medium text-zinc-600 transition hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white"
              >{item.label}<Icon name="external" size={14} class="opacity-60" /></a>
            </li>
          ))}
        </ul>

        <button
          id="menu-button"
          type="button"
          class="ml-auto grid size-10 place-items-center rounded-lg text-zinc-700 hover:bg-zinc-100 md:hidden dark:text-zinc-300 dark:hover:bg-zinc-800"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Open menu"
        >
          <Icon name="menu" size={22} class="menu-open" />
          <Icon name="close" size={22} class="menu-close hidden" />
        </button>
      </nav>

      <div id="mobile-menu" class="hidden border-t border-zinc-200 md:hidden dark:border-zinc-800">
        <ul class="mx-auto max-w-6xl space-y-1 px-4 py-3">
          {nav.internal.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={here === item.href ? 'page' : undefined}
                class="block rounded-lg px-3 py-2.5 font-medium text-zinc-700 hover:bg-zinc-100 aria-[current=page]:bg-brand-50 aria-[current=page]:text-brand-700 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:aria-[current=page]:bg-brand-700/20 dark:aria-[current=page]:text-brand-300"
              >{item.label}</a>
            </li>
          ))}
          {nav.external.map((item) => (
            <li>
              <a href={item.href} target="_blank" rel="noopener" class="flex items-center justify-between rounded-lg px-3 py-2.5 font-medium text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800">
                {item.label}<Icon name="external" size={16} class="opacity-50" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </header>

    <main id="content" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-zinc-200 dark:border-zinc-800">
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-8 sm:flex-row sm:px-6">
        <p class="text-sm text-zinc-500">&copy; {person.handle} {new Date().getFullYear()}</p>
        <ul class="flex items-center gap-2">
          {footerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener"
                class="grid size-10 place-items-center rounded-full text-zinc-500 transition hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-white"
              ><Icon name={link.icon} size={18} label={link.label} /></a>
            </li>
          ))}
        </ul>
      </div>
    </footer>
  </body>
</html>

<script>
  const button = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');

  button?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    button.querySelector('.menu-open')?.classList.toggle('hidden', open);
    button.querySelector('.menu-close')?.classList.toggle('hidden', !open);
  });
</script>
