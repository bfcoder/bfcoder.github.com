---
import '../styles/global.css';
import Icon from '@components/Icon.astro';
import { currentPath, nav, person, social } from '@data/site';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = `${person.name} (${person.handle}): ${person.tagline}`,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, import.meta.env.SITE).href;
const here = currentPath(Astro.url.pathname);
// Shown in the prompt: "~" on the home page, "~/projects" elsewhere. The
// 404 page stays at "~" since its body shows the failed `cd`.
const cwd = here === '/' || here === '/404' ? '~' : `~${here}`;
// Nav items read like relative paths: ./about, ./projects
const label = (href: string) => (href === '/' ? './about' : `.${href}`);
const footerLinks = [social.github, social.stackoverflow, social.twitter, social.blog];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070a07" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&display=swap" />
    <title>{title}</title>

    <link rel="canonical" href={canonicalUrl}/>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-term-green focus:px-3 focus:py-2 focus:text-term-bg">Skip to content</a>

    <header class="sticky top-0 z-40 border-b border-term-line bg-term-bg/85 backdrop-blur">
      <nav class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4 sm:px-6" aria-label="Main">
        <a href="/" class="shrink-0 text-sm no-underline" aria-label={`${person.handle}, home`}>
          <span class="text-term-green text-glow">{person.handle}@web</span><span class="text-term-dim">:</span><span class="text-term-cyan">{cwd}</span><span class="text-term-dim">$</span><span class="cursor text-term-green" aria-hidden="true"></span>
        </a>

        <ul class="ml-auto hidden items-center gap-1 text-sm md:flex">
          {nav.internal.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={here === item.href ? 'page' : undefined}
                class="px-2 py-1 text-term-dim transition-colors hover:text-term-green aria-[current=page]:bg-term-green aria-[current=page]:text-term-bg"
              >{label(item.href)}</a>
            </li>
          ))}
          <li aria-hidden="true" class="mx-2 text-term-line">|</li>
          {nav.external.map((item) => (
            <li>
              <a href={item.href} target="_blank" rel="noopener" class="inline-flex items-center gap-1 px-2 py-1 text-term-dim transition-colors hover:text-term-amber">
                {item.label.toLowerCase()}<Icon name="external" size={12} />
              </a>
            </li>
          ))}
        </ul>

        <button
          id="menu-button"
          type="button"
          class="ml-auto border border-term-line px-2.5 py-1 text-sm text-term-green hover:border-term-green md:hidden"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Open menu"
        ><span class="menu-open">[≡]</span><span class="menu-close hidden">[x]</span></button>
      </nav>

      <div id="mobile-menu" class="hidden border-t border-term-line md:hidden">
        <ul class="mx-auto max-w-6xl px-4 py-3 text-sm">
          {nav.internal.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={here === item.href ? 'page' : undefined}
                class="block px-2 py-2 text-term-text before:text-term-dim before:content-['>_'] hover:text-term-green aria-[current=page]:text-term-green aria-[current=page]:before:text-term-amber"
              >{label(item.href)}</a>
            </li>
          ))}
          {nav.external.map((item) => (
            <li>
              <a href={item.href} target="_blank" rel="noopener" class="flex items-center px-2 py-2 text-term-text before:mr-[1ch] before:text-term-dim before:content-['>'] hover:text-term-amber">
                <span class="mr-auto">{item.label.toLowerCase()}</span><Icon name="external" size={14} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </header>

    <main id="content" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-term-line">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <p class="text-term-dim"><span class="prompt">logout</span> <span class="text-term-line">#</span> &copy; {person.handle} {new Date().getFullYear()}</p>
        <ul class="flex flex-wrap gap-x-4 gap-y-1">
          {footerLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener" class="text-term-dim transition-colors hover:text-term-green">[{link.label.toLowerCase()}]</a>
            </li>
          ))}
        </ul>
      </div>
    </footer>
  </body>
</html>

<script>
  const button = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');

  button?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    button.querySelector('.menu-open')?.classList.toggle('hidden', open);
    button.querySelector('.menu-close')?.classList.toggle('hidden', !open);
  });
</script>
